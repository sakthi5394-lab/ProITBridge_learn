# Copy this file to .env and adjust as needed. app.py does not load .env
# automatically by default - use python-dotenv if you want that, or export
# these variables in your shell before running the app.

# Path to the trained Keras model file
MODEL_PATH=models/denoise_image.h5

# Flask secret key (used for session signing; change for any real deployment)
SECRET_KEY=change-me-in-production
